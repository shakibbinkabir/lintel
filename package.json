{
  "name": "lintel",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "fake-session": "node scripts/fake-session.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p lintel-hook",
    "prebuild": "cargo build --release -p lintel-hook",
    "helper": "dotnet publish helper/lintel-hw.csproj -c Release -o helper/bin/publish",
    "pack": "npm run helper && cargo build --release -p lintel-hook -p lintel-speak && tauri build --config src-tauri/tauri.helper.conf.json && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "^2"
  }
}
